APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail Configuration (Mailtrap or Gmail SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# Dedicated environment variables for dynamic switching in verification:
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=

GMAIL_USERNAME=
GMAIL_PASSWORD=

MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Hybrid Deployment Configuration (Vercel + Local System) ─────────────────
# PUBLIC_PORTAL_URL: Citizen-facing domain (e.g. https://your-civicore.vercel.app)
PUBLIC_PORTAL_URL=

# CORS_ALLOWED_ORIGINS: Comma-separated domains allowed to connect to API
CORS_ALLOWED_ORIGINS=https://localhost:5173,https://your-civicore.vercel.app

# Frontend Build Flags (used during Vite build)
# Set to 'true' on Vercel build to mount only public portal routes
VITE_PUBLIC_PORTAL_ONLY=false
# Points to Cloudflare Tunnel (Plan A) or Cloud API URL (Plan B)
VITE_API_BASE_URL=

# ── Optional Plan B: Cloud Portal Database Fallback ──────────────────────────
# Leave DB_PORTAL_CONNECTION blank for Plan A (Default - all local MySQL).
# Set to 'cloud_portal' if switching to Plan B (24/7 cloud DB for tickets).
DB_PORTAL_CONNECTION=
DB_PORTAL_HOST=127.0.0.1
DB_PORTAL_PORT=3306
DB_PORTAL_DATABASE=civicore_portal
DB_PORTAL_USERNAME=root
DB_PORTAL_PASSWORD=

